{
  "name": "glasskit-web",
  "version": "1.4.0",
  "description": "GlassKit Web – Astro-Template in der GlassKit-Designsprache: Glassmorphism-Websites für B2C und B2B",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run check:tokens && npm run check:markup",
    "check:tokens": "node scripts/check-light-mirror.mjs",
    "check:markup": "node scripts/check-markup.mjs",
    "test": "npm run check && playwright test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@jungherz-de/glasskit": "^1.26.0",
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
