---
import '@jungherz-de/glasskit/glasskit.css';
import '../styles/site.css';
import '../styles/brand.css'; /* Kunden-Branding: Token-Overrides, lädt zuletzt */
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeaderEn from '../components/en/SiteHeader.astro';
import SiteFooterEn from '../components/en/SiteFooter.astro';
import { siteName, defaultTitle, defaultDescription, href, base, languages, defaultLang, pathLang, localeHref } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute oder base-relative URL; Standard: public/og.png (beim Rebranding ersetzen) */
  ogImage?: string;
  /** false auf Seiten ohne Übersetzung (z. B. Blog, 404): keine hreflang-Links,
      der Sprach-Umschalter führt zur Startseite der Zielsprache. */
  translated?: boolean;
}
const { title = defaultTitle, description = defaultDescription, ogImage = href('/og.png'), translated = true } = Astro.props;
// Sprache kommt aus der URL (Default an der Wurzel, weitere unter /<code>/).
const lang = pathLang(Astro.url.pathname);
const ogLocale = languages.find((l) => l.code === lang)?.locale ?? 'de_DE';
// Trailing Slash erzwingen – GitHub Pages liefert Verzeichnis-URLs, und die
// Sitemap listet sie mit Slash; Canonical muss dieselbe Form haben.
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
// Skip-Link-Text je Sprache — die einzige Copy im Layout. Weitere Sprache:
// eine Zeile hier (SKILL.md §3b); fehlt sie, greift Englisch.
const skipLabels: Record<string, string> = { de: 'Zum Inhalt springen', en: 'Skip to content' };
const skipLabel = (code: string) => skipLabels[code] ?? skipLabels.en;
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    {languages.length > 1 && translated && (
      <>
        {languages.map((l) => (
          <link rel="alternate" hreflang={l.code} href={new URL(localeHref(canonicalPath, l.code), Astro.site)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL(localeHref(canonicalPath, defaultLang), Astro.site)} />
      </>
    )}
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} Blog`} href={href('/rss.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Bootstrap MUSS is:inline im Head bleiben: setzt js-Marker, Theme,
        Zielgruppe und data-path-lang (für die zweisprachige 404) vor dem
        ersten Paint. Gebündelt/deferred gäbe es einen Theme-Flash und kurz
        doppelte B2C/B2B- bzw. DE/EN-Inhalte. */}
    <script is:inline define:vars={{ base, altLangs: languages.filter((l) => l.code !== defaultLang).map((l) => l.code), defaultLang }}>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        if (!root.hasAttribute('data-theme')) {
          root.setAttribute('data-theme', matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        }
        if (!root.hasAttribute('data-audience')) root.setAttribute('data-audience', 'b2c');
        var seg = location.pathname.slice(base.length).split('/')[1];
        root.setAttribute('data-path-lang', altLangs.indexOf(seg) > -1 ? seg : defaultLang);
      })();
    </script>
  </head>
  <body>
    {/* id="top" (Ziel der Brand-Links) muss auf dem scrollenden Inhalt liegen —
        auf dem fixed Header würde ein Same-Page-Klick auf /#top nicht scrollen. */}
    <div class="glass-bg" id="top">
      {/* Skip-Link: erster Tab-Stopp jeder Seite, springt über die Header-
          Navigation in <main id="main">. Sichtbar erst mit Tastaturfokus
          (.glw-skip in site.css). Auf nicht übersetzten Seiten je Sprachzweig
          wie Header und Footer. */}
      {translated === false && languages.length > 1 ? (
        <>
          <div class="glw-i18n glw-i18n--de"><a class="glass-btn glass-btn--secondary glass-btn--sm glass-btn--auto glw-skip" href="#main">{skipLabel('de')}</a></div>
          <div class="glw-i18n glw-i18n--en" lang="en"><a class="glass-btn glass-btn--secondary glass-btn--sm glass-btn--auto glw-skip" href="#main">{skipLabel('en')}</a></div>
        </>
      ) : (
        <a class="glass-btn glass-btn--secondary glass-btn--sm glass-btn--auto glw-skip" href="#main">{skipLabel(lang)}</a>
      )}
      {/* Header/Footer je Sprachzweig (Nav-Labels sind Copy). Eine weitere
          Sprache bekommt hier einen weiteren Zweig — siehe SKILL.md §3b.
          Nicht übersetzte Seiten (404, eine Datei für alle Pfade): beide
          Zweige rendern, sichtbar per data-path-lang (CSS .glw-i18n--*). */}
      {translated === false && languages.length > 1 ? (
        <>
          <div class="glw-i18n glw-i18n--de"><SiteHeader translated={false} /></div>
          <div class="glw-i18n glw-i18n--en" lang="en"><SiteHeaderEn translated={false} /></div>
        </>
      ) : lang === 'en' ? (
        <SiteHeaderEn translated={translated} />
      ) : (
        <SiteHeader translated={translated} />
      )}
      {/* Das einzige <main> der Seite: Seiten und Komponenten setzen kein
          eigenes. tabindex="-1", damit der Skip-Link den Fokus wirklich hierher
          setzt; Header und Footer bleiben außerhalb (eigene Landmarks). */}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {translated === false && languages.length > 1 ? (
        <>
          <div class="glw-i18n glw-i18n--de"><SiteFooter /></div>
          <div class="glw-i18n glw-i18n--en" lang="en"><SiteFooterEn /></div>
        </>
      ) : lang === 'en' ? (
        <SiteFooterEn />
      ) : (
        <SiteFooter />
      )}
    </div>
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
